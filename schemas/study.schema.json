{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soma:study:1.0.0",
  "title": "Reference-sphere lunar geometry study",
  "type": "object",
  "additionalProperties": false,
  "required": ["study_version", "analysis_type", "frame", "reference_radius_m", "surface_model", "sites", "time", "spacecraft_refs"],
  "properties": {
    "study_version": {"const": "1.0.0"},
    "analysis_type": {"const": "geometry"},
    "frame": {"const": "MOON_ME_DE421"},
    "reference_radius_m": {"type": "number", "exclusiveMinimum": 0},
    "surface_model": {"const": "reference_sphere"},
    "sites": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/site"}},
    "time": {
      "type": "object", "additionalProperties": false,
      "required": ["start_utc", "end_utc", "step_s"],
      "properties": {
        "start_utc": {"type": "string", "format": "date-time"},
        "end_utc": {"type": "string", "format": "date-time"},
        "step_s": {"type": "number", "minimum": 10}
      }
    },
    "spacecraft_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
  },
  "$defs": {
    "site": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "latitude_deg", "longitude_deg_east", "elevation_m", "antenna_height_m", "panel_height_m"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "latitude_deg": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude_deg_east": {"type": "number", "minimum": -180, "exclusiveMaximum": 180},
        "elevation_m": {"type": "number"},
        "antenna_height_m": {"type": "number", "minimum": 0},
        "panel_height_m": {"type": "number", "minimum": 0}
      }
    }
  }
}
