{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix web ci",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{soma/**,data/*.manifest.json}",
      "excludeFiles": "{web/**,tests/**,fixtures/**,.venv/**,tatcenv/**,plan/**,task_outputs/**,.runtime/**,.git/**,**/__pycache__/**}"
    }
  },
  "rewrites": [
    {"source": "/api/moon/:path*", "destination": "/api/index"},
    {"source": "/((?!api/).*)", "destination": "/index.html"}
  ]
}
