# Optional scoped Cesium ion application token with access to Moon asset 2684829.
VITE_CESIUM_ION_TOKEN=
# The default live client uses the same-origin Vite proxy to Python on port 8000.
VITE_SOMA_API_URL=/api
# Set fixture explicitly for offline captured results. Failed live jobs never fall back.
VITE_SOMA_MODE=live
