{
  "name": "soma-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:fixtures": "node scripts/sync-fixtures.mjs",
    "sync:science": "node scripts/sync-science.mjs",
    "sync:physical": "node scripts/sync-physical.mjs",
    "predev": "node scripts/copy-cesium.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/copy-cesium.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test ../tests/web/*.test.mjs",
    "test:browser": "playwright test --config playwright.config.js",
    "test:live": "playwright test --config playwright.live.config.js",
    "test:physical": "playwright test --config playwright.physical.config.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cesium": "1.147.0",
    "vite": "8.3.8"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1"
  }
}
