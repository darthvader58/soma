FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    SOMA_DATA_ROOT=/data/sources SOMA_RESEARCH_RUN_ROOT=/data/runs \
    OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
COPY pyproject.toml requirements-research.txt ./
COPY soma ./soma
COPY schemas ./schemas
COPY data ./data
COPY scripts/prepare-research-data.py ./scripts/prepare-research-data.py
RUN pip install --no-cache-dir -r requirements-research.txt '.[analysis,planning,service]' \
    && python scripts/prepare-research-data.py --output /opt/soma-sources
COPY deploy/research/start.py ./deploy/research/start.py
EXPOSE 8000
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('PORT','8000')+'/health',timeout=4)"
CMD ["python", "deploy/research/start.py"]
